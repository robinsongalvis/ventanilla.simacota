# Outlook/Microsoft 365:  EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notificaciones@simacota-santander.gov.co
