NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Do not prefix these with NEXT_PUBLIC.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"firebase-adminsdk-...@....iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
CRON_SECRET=CAMBIAR_POR_SECRETO_SEGURO

# Inferencia de IA (Gemini API)
GEMINI_API_KEY=

# Telemetría e Integración de Errores (Sentry)
# SENTRY_DSN           — Server-only: API routes y Server Components.
# NEXT_PUBLIC_SENTRY_DSN — Mismo DSN, expuesto al cliente para errores de navegador.
# Sin ellos, logError() solo escribe en consola (no-op silencioso).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opcionales — para subir source maps en CI/CD (mejora stack traces en Sentry)
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Notificaciones por email (Nodemailer)
# Gmail con App Password: EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587
# Outlook/Microsoft 365:  EMAIL_HOST=smtp.office365.com  EMAIL_PORT=587
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notificaciones@simacota-santander.gov.co
EMAIL_PASS=
EMAIL_FROM="Alcaldía de Simacota <notificaciones@simacota-santander.gov.co>"

# WhatsApp institucional (server-only)
# WHATSAPP_PROVIDER=none | mock | meta | twilio | wati
WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_FROM_NUMBER=

# Firma digital certificada futura (server-only)
DIGITAL_SIGNATURE_PROVIDER=
