rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function userProfile() {
      return get(userPath()).data;
    }

    function userRole() {
      return hasUserProfile() ? userProfile().rol : null;
    }

    function userTenant() {
      return hasUserProfile() ? userProfile().tenantId : null;
    }

    function isAdmin() {
      return userRole() == 'ADMIN';
    }

    function isFuncionario() {
      return userRole() == 'FUNCIONARIO';
    }

    function isRecepcionista() {
      return userRole() == 'RECEPCIONISTA';
    }

    /** Jefe de Dependencia: lectura de su tenant, sin acciones de resolución. */
    function isJefeDependencia() {
      return userRole() == 'JEFE_DEPENDENCIA';
    }

    /** Control Interno: lectura de todos los tenants, sin escritura. */
    function isControlInterno() {
      return userRole() == 'CONTROL_INTERNO';
    }

    /** Cualquier rol que puede acceder al panel interno. */
    function isInternalUser() {
      return isAdmin() || isFuncionario() || isRecepcionista()
          || isJefeDependencia() || isControlInterno();
    }

    /**
     * Roles que pueden escribir entradas de trazabilidad, CON aislamiento por
     * tenant (ADR-0008 / R8). Refleja el mismo patrón `get()` del `allow read`
     * de esta subcolección: Admin y Recepcionista operan cross-tenant (ventanilla
     * única, igual que en su lectura); el Funcionario solo puede escribir sobre
     * radicados cuyo `oficinaDestino` coincide con su propio tenant. Jefe y
     * Control Interno quedan fuera (son solo lectura).
     */
    function canWriteTrazabilidad(radicadoId, database) {
      return isAdmin() || isRecepcionista()
        || (isFuncionario()
            && get(/databases/$(database)/documents/ventanilla_radicados/$(radicadoId))
                  .data.clasificacion.oficinaDestino == userTenant());
    }

    function assignedTenant(data) {
      return data.clasificacionIA != null
        && data.clasificacionIA.oficinaDestino == userTenant();
    }

    function validRole(role) {
      return role in ['ADMIN', 'FUNCIONARIO', 'RECEPCIONISTA', 'JEFE_DEPENDENCIA', 'CONTROL_INTERNO'];
    }

    // NOTA: los validadores de escritura cliente (validRadicadoCreate,
    // validRadicadoUpdate, validVentanillaUpdate, validVentanillaEstado)
    // se retiraron: desde "Cierra seguridad go-live" (bf42175) toda mutación
    // de radicados es server-side vía Admin SDK y los allow quedaron en false.
    // La validación de estados vive en los endpoints de acción de /api.

    function canReadRadicado(data) {
      return isAdmin()
        || (isFuncionario() && assignedTenant(data))
        || (isRecepcionista() && assignedTenant(data));
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Recepcionista y Admin necesitan listar usuarios para el selector
      // de responsable funcional (MIPG-2 — asignación).
      allow list: if isAdmin() || isRecepcionista();

      allow create: if isAdmin()
        && request.resource.data.rol is string
        && validRole(request.resource.data.rol)
        && request.resource.data.tenantId is string;

      allow update: if isAdmin()
        && request.resource.data.rol is string
        && validRole(request.resource.data.rol)
        && request.resource.data.tenantId is string;

      allow delete: if false;
    }

    match /radicados/{radicadoId} {
      // La consulta ciudadana publica debe pasar por /api/consulta/{radicadoId},
      // que devuelve solo campos publicos usando cuenta de servicio.
      allow get: if canReadRadicado(resource.data);

      // El dashboard debe consultar con filtro de tenant para FUNCIONARIO/RECEPCIONISTA.
      allow list: if isAdmin()
        || ((isFuncionario() || isRecepcionista()) && canReadRadicado(resource.data));

      // Legacy cerrado para nuevas escrituras. La radicación vigente usa
      // /api/radicacion + Admin SDK sobre ventanilla_radicados.
      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }

    // ── Sistema MIPG: radicados institucionales ─────────────────────────────
    match /ventanilla_radicados/{radicadoId} {
      // Admin, Recepcionista y Control Interno ven todos los tenants.
      // Funcionario y Jefe de Dependencia solo ven su propia dependencia.
      allow get: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && resource.data.clasificacion.oficinaDestino == userTenant());

      allow list: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && resource.data.clasificacion.oficinaDestino == userTenant());

      // Solo admin y recepcionista pueden radicar institucionalmente.
      allow create: if (isAdmin() || isRecepcionista())
        && request.resource.data.radicadoId == radicadoId;

      // Mutaciones críticas pasan por APIs server-side con Admin SDK.
      // Esto blinda cumplioTermino, estadoActual, clasificación, prórrogas y respuesta oficial.
      allow update: if false;

      allow delete: if false;
    }

    match /ai_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_feedback/{feedbackId} {
      allow read: if isInternalUser();
      allow write: if false;
    }

    match /ai_auditoria/{auditoriaId} {
      allow read: if isInternalUser();
      allow write: if false;
    }

    match /ventanilla_radicados/{radicadoId}/trazabilidad/{eventoId} {
      // Lectura: todos los roles internos (incluye Jefe y Control Interno para auditoría).
      allow read: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && get(/databases/$(database)/documents/ventanilla_radicados/$(radicadoId))
                  .data.clasificacion.oficinaDestino == userTenant());
      // Escritura: roles operativos CON aislamiento por tenant (ADR-0008 / R8).
      // El Funcionario solo escribe sobre radicados de su propio tenant; Jefe y
      // Control Interno son solo lectura.
      allow create: if canWriteTrazabilidad(radicadoId, database);
      allow update, delete: if false;
    }

    // ── Sprint Radicación de salida: correspondencia despachada ───────────
    // Serie propia 2-SAL-{año}. El registro es inmutable: una corrección
    // se hace con una salida nueva — el libro de salidas nunca se edita.
    match /ventanilla_salidas/{salidaId} {
      // Admin, Recepcionista y Control Interno leen el libro completo;
      // Funcionario y Jefe solo las salidas despachadas por su dependencia.
      allow get, list: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && resource.data.dependenciaOrigen == userTenant());

      // Solo recepción/admin registran salidas (ventanilla única de salida).
      allow create: if (isAdmin() || isRecepcionista())
        && request.resource.data.salidaId == salidaId;

      allow update, delete: if false;
    }

    // ── Planilla de reparto: control de entrega del documento físico ──────
    // Toda escritura pasa por /api/planillas/* con Admin SDK (consecutivo
    // transaccional, entregas todo-o-nada, anulación solo sin firmas).
    // Lectura para quienes operan o auditan la cadena de custodia.
    match /ventanilla_planillas/{planillaId} {
      allow get, list: if isAdmin() || isRecepcionista() || isControlInterno();
      allow create, update, delete: if false;
    }

    // ── Contadores de consecutivo anual ────────────────────────────────────
    match /counters/{document} {
      // Lectura y escritura transaccional para generar el número de radicado.
      allow read, write: if isAdmin() || isRecepcionista();
    }

    // ── Reserva de unicidad de números de expediente (Fase 2) ─────────────
    // Doc id = número de expediente formateado. Escrita SOLO por el servidor
    // (Admin SDK, tx.create en lib/server/emitir-numero-expediente.ts);
    // ningún cliente lee ni escribe.
    match /unicidad_expedientes/{id} {
      allow read, write: if false;
    }

    // ── Motor de expedientes — persistencia (D3 ADR-0026; DF-1..DF-9 ADR-0029)
    // ESQUEMA (decisión firestore-datos, 2026-08-08):
    //  · expedientes/{expedienteId}: id SINTÉTICO (DF-9) — el número de
    //    expediente NUNCA es el doc id; viaja como atributo
    //    `numeroExpediente {numero, serieId, año, colision?}` emitido en
    //    transacción por lib/server/emitir-numero-expediente.ts. El doc
    //    raíz es el contrato `Expediente` (lib/motor-expedientes/tipos.ts,
    //    congelado por ADR-0029) MÁS: `estadoJuridico`
    //    (EstadoJuridicoLicencia, DF-5) y `esPrueba?: boolean` — marca de
    //    DEMO: un expediente de demo JAMÁS consume la serie legal y su
    //    `numeroExpediente.numero` lleva prefijo 'DEMO-', nunca el formato
    //    legal puro {dane}-{curaduria}-{AA}-{CCCC} (DF-1).
    //  · Subcolección actuaciones/{actuacionId}: trazabilidad APPEND-ONLY
    //    (D8) = contrato `Actuacion` + `tenantId` DENORMALIZADO — cierra,
    //    para esta subcolección, la deuda #6 de ADR-0026 §A2: habilita
    //    collectionGroup y futuras reglas de lectura por tenant sin get()
    //    del documento padre.
    // ACCESO (D3): escritura EXCLUSIVAMENTE server-side — Admin SDK, que
    // bypasea estas reglas — así que create/update/delete quedan en false
    // y cierran por diseño las clases CR-1/CR-2/R8. La lectura TAMBIÉN
    // queda en false: bandeja y detalle se sirven por route handlers
    // server-side que filtran por tenant (mismo patrón server-only de
    // unicidad_expedientes). Si una fase futura habilita lectura cliente,
    // exigirá resource.data.tenantId == userTenant() y query con filtro
    // explícito (ver ADVERTENCIA sobre 'list' más abajo).
    match /expedientes/{expedienteId} {
      allow read, write: if false;

      // Append-only real: ni siquiera el create es de cliente (D8 — actor
      // capturado en servidor; el cliente nunca escribe trazabilidad del
      // expediente, a diferencia de ventanilla_radicados/trazabilidad).
      match /actuaciones/{actuacionId} {
        allow read, write: if false;
      }
    }

    // ── Auditoría administrativa — append-only, solo lectura Admin ────────
    match /admin_auditoria/{eventoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Auditoría SIMI — append-only, solo lectura Admin ─────────────────
    match /simi_auditoria/{eventoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Control Interno: hallazgos, planes de mejora, alertas y eventos ─
    // Todas las escrituras pasan por APIs server-side con Admin SDK que
    // validan rol, tenantId y dejan trazabilidad. Las reglas blindan
    // el acceso de lectura (Admin y Control Interno ven todo; Jefe y
    // Funcionario solo su dependencia — H-10).
    //
    // ADVERTENCIA sobre 'list': Firestore evalúa la regla por documento,
    // pero si el cliente lanza una query 'list' que NO filtra por
    // tenantId, la consulta entera falla aunque algunos docs cumplan la
    // regla. Si en el futuro se consulta desde cliente como
    // JEFE_DEPENDENCIA o FUNCIONARIO, la query DEBE incluir
    // .where('tenantId', '==', userTenant).

    match /control_interno_hallazgos/{hallazgoId} {
      allow get, list: if isAdmin() || isControlInterno()
        || (isJefeDependencia() && resource.data.tenantId == userTenant());
      allow create, update, delete: if false;
    }

    match /control_interno_planes_mejora/{planId} {
      allow get, list: if isAdmin() || isControlInterno()
        || ((isJefeDependencia() || isFuncionario())
            && resource.data.tenantId == userTenant());
      allow create, update, delete: if false;
    }

    match /control_interno_alertas/{alertaId} {
      allow get, list: if isAdmin() || isControlInterno();
      allow create, update, delete: if false;
    }

    match /control_interno_eventos/{eventoId} {
      allow get, list: if isAdmin() || isControlInterno();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
