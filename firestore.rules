rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserProfile() {
      return signedIn() && exists(userPath());
    }

    function userProfile() {
      return get(userPath()).data;
    }

    function userRole() {
      return hasUserProfile() ? userProfile().rol : null;
    }

    function userTenant() {
      return hasUserProfile() ? userProfile().tenantId : null;
    }

    function isAdmin() {
      return userRole() == 'ADMIN';
    }

    function isFuncionario() {
      return userRole() == 'FUNCIONARIO';
    }

    function isRecepcionista() {
      return userRole() == 'RECEPCIONISTA';
    }

    /** Jefe de Dependencia: lectura de su tenant, sin acciones de resolución. */
    function isJefeDependencia() {
      return userRole() == 'JEFE_DEPENDENCIA';
    }

    /** Control Interno: lectura de todos los tenants, sin escritura. */
    function isControlInterno() {
      return userRole() == 'CONTROL_INTERNO';
    }

    /** Cualquier rol que puede acceder al panel interno. */
    function isInternalUser() {
      return isAdmin() || isFuncionario() || isRecepcionista()
          || isJefeDependencia() || isControlInterno();
    }

    /** Solo los roles que pueden escribir entradas de trazabilidad. */
    function canWriteTrazabilidad() {
      return isAdmin() || isFuncionario() || isRecepcionista();
    }

    function assignedTenant(data) {
      return data.clasificacionIA != null
        && data.clasificacionIA.oficinaDestino == userTenant();
    }

    function validRole(role) {
      return role in ['ADMIN', 'FUNCIONARIO', 'RECEPCIONISTA', 'JEFE_DEPENDENCIA', 'CONTROL_INTERNO'];
    }

    function validEstado(estado) {
      return estado in [
        'PENDIENTE',
        'EN_REVISION',
        'EN_PROCESO',
        'RESUELTO',
        'DEVUELTO',
        'RECHAZADO'
      ];
    }

    function validRadicadoCreate() {
      return request.resource.data.keys().hasAll([
        'radicadoId',
        'origen',
        'fechaCreacion',
        'estadoActual',
        'prioridad',
        'ciudadano',
        'clasificacionIA',
        'archivos',
        'auditoria'
      ])
      && request.resource.data.keys().hasOnly([
        'radicadoId',
        'origen',
        'fechaCreacion',
        'estadoActual',
        'prioridad',
        'ciudadano',
        'clasificacionIA',
        'archivos',
        'auditoria',
        'notasInternas',
        'tipoSolicitudId',
        'tipoSolicitudNombre',
        'tipoPresentacion',
        'esAnonimo',
        'identidadReservada',
        'canalRespuesta'
      ])
      && request.resource.data.radicadoId is string
      && request.resource.data.origen in ['WEB', 'FISICO_ESCANER']
      && (
        request.resource.data.origen == 'WEB'
        || (request.resource.data.origen == 'FISICO_ESCANER' && (isAdmin() || isRecepcionista()))
      )
      && (
        !request.resource.data.keys().hasAny(['notasInternas'])
        || isAdmin()
        || isRecepcionista()
      )
      && request.resource.data.estadoActual == 'PENDIENTE'
      && request.resource.data.prioridad in ['ROJO', 'NARANJA', 'AMARILLO']
      && request.resource.data.ciudadano.nombre is string
      && request.resource.data.ciudadano.email is string
      && request.resource.data.ciudadano.telefono is string
      && request.resource.data.archivos is list
      && request.resource.data.auditoria is list
      && (
        !request.resource.data.keys().hasAny(['tipoSolicitudId'])
        || request.resource.data.tipoSolicitudId in [
          'PETICION',
          'PETICION_INFORMACION',
          'PETICION_AUTORIDADES',
          'QUEJA',
          'RECLAMO',
          'SUGERENCIA',
          'FELICITACION',
          'DENUNCIA',
          'HABEAS_DATA',
          'INFORMATIVO',
          'LICENCIA_CONSTRUCCION',
          'ENTES_CONTROL_URGENTE'
        ]
      )
      && (
        !request.resource.data.keys().hasAny(['tipoPresentacion'])
        || request.resource.data.tipoPresentacion in ['IDENTIFICADA', 'ANONIMA', 'RESERVADA']
      )
      && (
        !request.resource.data.keys().hasAny(['canalRespuesta'])
        || request.resource.data.canalRespuesta in ['CORREO', 'PRESENCIAL', 'TELEFONO', 'DIRECCION_FISICA']
      )
      && (
        !request.resource.data.keys().hasAny(['esAnonimo'])
        || request.resource.data.esAnonimo is bool
      )
      && (
        !request.resource.data.keys().hasAny(['identidadReservada'])
        || request.resource.data.identidadReservada is bool
      );
    }

    function validRadicadoUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'estadoActual',
        'auditoria'
      ])
      && validEstado(request.resource.data.estadoActual)
      && request.resource.data.auditoria is list;
    }

    function canReadRadicado(data) {
      return isAdmin()
        || (isFuncionario() && assignedTenant(data))
        || (isRecepcionista() && assignedTenant(data));
    }

    function canUpdateRadicado(data) {
      return isAdmin()
        || (isFuncionario() && assignedTenant(data))
        || (isRecepcionista() && assignedTenant(data));
    }

    // Estados válidos que el cliente puede escribir en ventanilla_radicados.
    // POR_VENCER y VENCIDO solo los escribe Admin SDK (Cloud Functions / backend);
    // quedan fuera de esta lista deliberadamente.
    function validVentanillaEstado(estado) {
      return estado in [
        'PENDIENTE',
        'EN_REVISION',
        'EN_PROCESO',
        'ASIGNADO',
        'RESUELTO',
        'DEVUELTO',
        'RECHAZADO',
        'PRORROGA'
      ];
    }

    function validVentanillaUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'estadoActual',
        'clasificacion',
        'feedbackIa',
        'termino',
        'ultimaActualizacion',
        'respuestaOficial',
        'cumplioTermino'     // MIPG Req 8: evidencia de cumplimiento de término legal
      ])
      && request.resource.data.ultimaActualizacion is string
      && validVentanillaEstado(request.resource.data.estadoActual);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Recepcionista y Admin necesitan listar usuarios para el selector
      // de responsable funcional (MIPG-2 — asignación).
      allow list: if isAdmin() || isRecepcionista();

      allow create: if isAdmin()
        && request.resource.data.rol is string
        && validRole(request.resource.data.rol)
        && request.resource.data.tenantId is string;

      allow update: if isAdmin()
        && request.resource.data.rol is string
        && validRole(request.resource.data.rol)
        && request.resource.data.tenantId is string;

      allow delete: if false;
    }

    match /radicados/{radicadoId} {
      // La consulta ciudadana publica debe pasar por /api/consulta/{radicadoId},
      // que devuelve solo campos publicos usando cuenta de servicio.
      allow get: if canReadRadicado(resource.data);

      // El dashboard debe consultar con filtro de tenant para FUNCIONARIO/RECEPCIONISTA.
      allow list: if isAdmin()
        || ((isFuncionario() || isRecepcionista()) && canReadRadicado(resource.data));

      // Legacy cerrado para nuevas escrituras. La radicación vigente usa
      // /api/radicacion + Admin SDK sobre ventanilla_radicados.
      allow create: if false;

      allow update: if false;

      allow delete: if false;
    }

    // ── Sistema MIPG: radicados institucionales ─────────────────────────────
    match /ventanilla_radicados/{radicadoId} {
      // Admin, Recepcionista y Control Interno ven todos los tenants.
      // Funcionario y Jefe de Dependencia solo ven su propia dependencia.
      allow get: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && resource.data.clasificacion.oficinaDestino == userTenant());

      allow list: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && resource.data.clasificacion.oficinaDestino == userTenant());

      // Solo admin y recepcionista pueden radicar institucionalmente.
      allow create: if (isAdmin() || isRecepcionista())
        && request.resource.data.radicadoId == radicadoId;

      // Mutaciones críticas pasan por APIs server-side con Admin SDK.
      // Esto blinda cumplioTermino, estadoActual, clasificación, prórrogas y respuesta oficial.
      allow update: if false;

      allow delete: if false;
    }

    match /ai_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /ai_feedback/{feedbackId} {
      allow read: if isInternalUser();
      allow write: if false;
    }

    match /ai_auditoria/{auditoriaId} {
      allow read: if isInternalUser();
      allow write: if false;
    }

    match /ventanilla_radicados/{radicadoId}/trazabilidad/{eventoId} {
      // Lectura: todos los roles internos (incluye Jefe y Control Interno para auditoría).
      allow read: if isAdmin() || isRecepcionista() || isControlInterno()
        || ((isFuncionario() || isJefeDependencia())
            && get(/databases/$(database)/documents/ventanilla_radicados/$(radicadoId))
                  .data.clasificacion.oficinaDestino == userTenant());
      // Escritura: solo roles operativos (Jefe y Control Interno son solo lectura).
      allow create: if canWriteTrazabilidad();
      allow update, delete: if false;
    }

    // ── Contadores de consecutivo anual ────────────────────────────────────
    match /counters/{document} {
      // Lectura y escritura transaccional para generar el número de radicado.
      allow read, write: if isAdmin() || isRecepcionista();
    }

    // ── Auditoría administrativa — append-only, solo lectura Admin ────────
    match /admin_auditoria/{eventoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Auditoría SIMI — append-only, solo lectura Admin ─────────────────
    match /simi_auditoria/{eventoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Control Interno: hallazgos, planes de mejora, alertas y eventos ─
    // Todas las escrituras pasan por APIs server-side con Admin SDK que
    // validan rol, tenantId y dejan trazabilidad. Las reglas blindan
    // el acceso de lectura (Control Interno y Admin ven todo).

    match /control_interno_hallazgos/{hallazgoId} {
      allow get, list: if isAdmin() || isControlInterno() || isJefeDependencia();
      allow create, update, delete: if false;
    }

    match /control_interno_planes_mejora/{planId} {
      // Jefe de dependencia debe poder ver planes asignados a su tenant
      // para reportar avances (la escritura pasa por API server-side).
      allow get, list: if isAdmin() || isControlInterno() || isJefeDependencia()
        || (isFuncionario() && resource.data.tenantId == userTenant());
      allow create, update, delete: if false;
    }

    match /control_interno_alertas/{alertaId} {
      allow get, list: if isAdmin() || isControlInterno();
      allow create, update, delete: if false;
    }

    match /control_interno_eventos/{eventoId} {
      allow get, list: if isAdmin() || isControlInterno();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
