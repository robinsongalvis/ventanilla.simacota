{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ventanilla-stage",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:stage"
      ],
      "autoPort": true
    },
    {
      "name": "ventanilla-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoPort": true
    },
    {
      "name": "ventanilla-celular",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-H",
        "0.0.0.0"
      ],
      "autoPort": true
    },
    {
      "name": "stage-celular",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/laboratorio/dev-stage.mjs",
        "-H",
        "0.0.0.0",
        "-p",
        "3200"
      ],
      "port": 3200,
      "autoPort": false
    },
    {
      "name": "rediseno-3100",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-H",
        "0.0.0.0",
        "-p",
        "3100"
      ],
      "port": 3100,
      "autoPort": false
    }
  ]
}
