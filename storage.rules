rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedRadicadoFile() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /radicados/{radicadoId}/{archivo} {
      // La radicación pública sube anexos vía Admin SDK en /api/radicacion.
      // Solo usuarios internos autenticados conservan subida directa temporal para radicación interna.
      allow create: if signedIn() && isAllowedRadicadoFile();

      allow read: if false;

      allow update, delete: if false;
    }

    match /respuestas/{radicadoId}/{archivo} {
      // La resolución moderna sube vía Admin SDK en /api/radicados/{id}/resolver.
      // Se mantiene autenticado para compatibilidad interna, nunca público.
      allow create: if signedIn()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';

      // Lectura solo via Admin SDK en /api/interno/archivo — nunca directa.
      allow read: if false;

      allow update, delete: if false;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
